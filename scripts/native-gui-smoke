#!/usr/bin/env bash
set -Eeuo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
binary="${NEUTRINO_NATIVE_BIN:-}"
rcsim="${NEUTRINO_NATIVE_RCSIM:-}"
display_name="${DISPLAY:-}"
web_port="${NEUTRINO_NATIVE_WEB_PORT:-8080}"
start_timeout="${NEUTRINO_NATIVE_GUI_START_TIMEOUT:-60}"
shutdown_timeout="${NEUTRINO_NATIVE_GUI_SHUTDOWN_TIMEOUT:-20}"

die() { printf 'FEHLER: %s\n' "$*" >&2; exit 1; }

check_screenshot_pixels() {
	local image=$1 nonzero distinct
	# Skip the XWD header and inspect the raw pixel payload.  A plausible file
	# size alone would also accept an empty or solid-color framebuffer.
	nonzero="$(tail -c +1025 "$image" | od -An -tu1 | awk '{ for (i = 1; i <= NF; i++) if ($i != 0) n++ } END { print n + 0 }')"
	distinct="$(tail -c +1025 "$image" | od -An -tu1 | awk '{ for (i = 1; i <= NF; i++) seen[$i] = 1 } END { for (v in seen) n++ ; print n + 0 }')"
	(( nonzero > 1000 && distinct >= 4 )) || die "Screenshot enthält keine plausible OSD-Pixeldaten: nonzero=${nonzero}, distinct=${distinct}"
}
[[ -n "$binary" ]] || die 'NEUTRINO_NATIVE_BIN muss auf das installierte Full-Core-Programm zeigen'
[[ -x "$binary" ]] || die "GUI-Binary fehlt oder ist nicht ausführbar: $binary"
[[ -n "$display_name" ]] || die 'DISPLAY ist nicht gesetzt; X11 oder Xvfb bereitstellen'
command -v glxinfo >/dev/null || die 'glxinfo fehlt; die X11-OpenGL-Umgebung kann nicht geprüft werden'
command -v curl >/dev/null || die 'curl fehlt; der kontrollierte Shutdown kann nicht ausgelöst werden'
[[ -n "$rcsim" ]] || rcsim="$(dirname "$binary")/rcsim"
[[ -x "$rcsim" ]] || die "rcsim fehlt oder ist nicht ausführbar: $rcsim"

"$repo/scripts/check-build-architecture" --compiler c++ "$binary" "$rcsim"
glxinfo -B >/dev/null 2> >(sed 's/^/GLX: /' >&2) || die "OpenGL/X11-Anzeige nicht nutzbar: $display_name"

run_dir="$(mktemp -d "${TMPDIR:-/tmp}/neutrino-native-gui.XXXXXX")"
pid=''

# The historical native core uses a fixed event socket.  A previous crash or
# forced test termination must not make the next run appear ready by mistake.
if [[ -S /tmp/neutrino.sock ]]; then
	if command -v fuser >/dev/null 2>&1 && fuser /tmp/neutrino.sock >/dev/null 2>&1; then
		die 'Neutrino-Event-Socket wird bereits von einem Prozess verwendet'
	fi
	rm -f /tmp/neutrino.sock
fi

pc_no_dvb="${NEUTRINO_PC_NO_DVB:-}"
if [[ -z "$pc_no_dvb" ]]; then
	if compgen -G '/dev/dvb/adapter*/frontend*' >/dev/null 2>&1; then
		pc_no_dvb=0
	else
		pc_no_dvb=1
	fi
fi
cleanup() {
	if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
		kill -TERM "$pid" 2>/dev/null || true
		for _ in {1..20}; do
			kill -0 "$pid" 2>/dev/null || break
			sleep 0.1
		done
		kill -KILL "$pid" 2>/dev/null || true
		wait "$pid" 2>/dev/null || true
	fi
	# The legacy core owns a fixed socket path and may leave the pathname
	# behind after a normal shutdown.  Remove it only when no process uses it.
	if [[ -S /tmp/neutrino.sock ]] && { ! command -v fuser >/dev/null 2>&1 || ! fuser /tmp/neutrino.sock >/dev/null 2>&1; }; then
		rm -f /tmp/neutrino.sock
	fi
	find "$run_dir" -depth -delete 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$run_dir/home" "$run_dir/config" "$run_dir/state"
log="$run_dir/neutrino.log"
HOME="$run_dir/home" XDG_CONFIG_HOME="$run_dir/config" XDG_STATE_HOME="$run_dir/state" \
	HAL_NOAVDEC="${HAL_NOAVDEC:-1}" NEUTRINO_PC_NO_DVB="$pc_no_dvb" DISPLAY="$display_name" \
	"$binary" --verbose 0 >"$log" 2>&1 &
pid=$!
printf 'STARTET: pid=%s display=%s log=%s\n' "$pid" "$display_name" "$log"

started=0
for _ in $(seq 1 "$((start_timeout * 4))"); do
	if ! kill -0 "$pid" 2>/dev/null; then
		break
	fi
	# Depending on the configured channel/start mode, the historic core may
	# enter tvMode() from InitZapper before RealRun() emits its later marker.
	# The menu/channel setup is the stable integration boundary here.  Require
	# that plus the GL thread; do not accept a process that merely stayed alive.
	if grep -q 'GLFB: GL thread starting' "$log" && grep -q 'render: reinit' "$log" \
		&& (grep -q '\[neutrino\] initialized everything' "$log" \
			|| grep -q '\[neutrino\] Creating channels lists' "$log"); then
		started=1
		break
	fi
	sleep 0.25
done
if ((started != 1)); then
	tail -120 "$log" >&2
	die 'Full-Core erreichte den GUI-Startmarker nicht'
fi
printf 'GUI-START: GLFB/OSD und Renderpfad nachweisbar\n'

for _ in {1..20}; do
	[[ -S /tmp/neutrino.sock ]] && break
	sleep 0.25
done
[[ -S /tmp/neutrino.sock ]] || { tail -120 "$log" >&2; die 'Neutrino-Event-Socket wurde nicht angelegt'; }
for endpoint in getchannel getbouquets; do
	api_status="$(curl --connect-timeout 1 --max-time 3 -sS -o "$run_dir/${endpoint}.json" \
		-w '%{http_code}' "http://127.0.0.1:${web_port}/control/${endpoint}?format=json" 2>/dev/null || true)"
	[[ "$api_status" == 200 ]] || { tail -120 "$log" >&2; die "HTTP-Control-Endpunkt ${endpoint} antwortete mit HTTP ${api_status}"; }
done
printf 'HTTP: getchannel/getbouquets antworten mit JSON und HTTP 200\n'
send_key() {
	local key=$1 attempt
	for attempt in {1..5}; do
		if "$rcsim" "$key"; then
			return 0
		fi
		if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
			break
		fi
		sleep 0.5
	done
	tail -120 "$log" >&2
	die "Eingabeereignis ${key} konnte nicht zugestellt werden"
}

send_key KEY_MENU
sleep 0.5
if command -v xwininfo >/dev/null 2>&1 && command -v xwd >/dev/null 2>&1; then
	# Read the complete xwininfo output first.  Piping directly into awk with
	# an early exit makes xwininfo receive SIGPIPE under pipefail (exit 141).
	window_tree="$(xwininfo -root -tree 2>/dev/null)"
	window_id="$(awk '/"Neutrino"/ { print $1; exit }' <<<"$window_tree")"
	[[ -n "$window_id" ]] || { tail -120 "$log" >&2; die 'Neutrino-X11-Fenster wurde nicht gefunden'; }
	screenshot="$run_dir/neutrino-menu.xwd"
	if ! xwd -id "$window_id" -silent -out "$screenshot" 2>"$run_dir/xwd.err"; then
		cat "$run_dir/xwd.err" >&2 || true
		tail -120 "$log" >&2
		die "Screenshot des Neutrino-Fensters fehlgeschlagen (Fenster ${window_id})"
	fi
	screenshot_size="$(stat -c '%s' "$screenshot")"
	((screenshot_size > 4096)) || die "GUI-Screenshot ist unplausibel klein: ${screenshot_size} Bytes"
	check_screenshot_pixels "$screenshot"
	printf 'VISUAL: Neutrino-Fenster aufgenommen (%s Bytes, %s)\n' "$screenshot_size" "$(file -b "$screenshot")"
else
	printf 'VISUAL: X11-Screenshot übersprungen (xwininfo/xwd fehlt)\n'
fi
send_key KEY_DOWN
send_key KEY_OK
sleep 0.5
if command -v xwininfo >/dev/null 2>&1 && command -v xwd >/dev/null 2>&1; then
	window_tree="$(xwininfo -root -tree 2>/dev/null)"
	window_id="$(awk '/"Neutrino"/ { print $1; exit }' <<<"$window_tree")"
	[[ -n "$window_id" ]] || { tail -120 "$log" >&2; die 'Neutrino-X11-Fenster nach Menüöffnung nicht gefunden'; }
	entry_screenshot="$run_dir/neutrino-menu-entry.xwd"
	if ! xwd -id "$window_id" -silent -out "$entry_screenshot" 2>"$run_dir/xwd-entry.err"; then
		cat "$run_dir/xwd-entry.err" >&2 || true
		tail -120 "$log" >&2
		die "Screenshot nach Menüöffnung fehlgeschlagen (Fenster ${window_id})"
	fi
	entry_size="$(stat -c '%s' "$entry_screenshot")"
	((entry_size > 4096)) || die "Menü-Screenshot ist unplausibel klein: ${entry_size} Bytes"
	check_screenshot_pixels "$entry_screenshot"
	printf 'MENU: KEY_DOWN/KEY_OK und zweiter Screenshot bestanden (%s Bytes)\n' "$entry_size"
else
	printf 'MENU: KEY_DOWN/KEY_OK zugestellt; zweiter Screenshot übersprungen\n'
fi
send_key KEY_EXIT
sleep 0.5
printf 'EINGABE: KEY_MENU, KEY_DOWN, KEY_OK und KEY_EXIT zugestellt\n'

status=000
for _ in {1..20}; do
	status="$(curl --connect-timeout 1 --max-time 2 -sS -o "$run_dir/shutdown.out" \
		-w '%{http_code}' "http://127.0.0.1:${web_port}/control/shutdown" 2>/dev/null || true)"
	[[ "$status" != 000 ]] && break
	sleep 0.5
done
[[ "$status" == 200 ]] || { tail -120 "$log" >&2; die "Shutdown-API antwortete mit HTTP $status"; }
printf 'SHUTDOWN: HTTP 200 über /control/shutdown\n'

for _ in $(seq 1 "$((shutdown_timeout * 4))"); do
	kill -0 "$pid" 2>/dev/null || break
	sleep 0.25
done
if kill -0 "$pid" 2>/dev/null; then
	tail -120 "$log" >&2
	die 'Full-Core beendete sich nach dem kontrollierten Shutdown nicht'
fi
set +e
wait "$pid"
exit_code=$?
set -e
pid=''
((exit_code < 128)) || die "Full-Core wurde durch Signal beendet (Exitcode $exit_code)"
grep -q 'GLFB: GL thread stopping' "$log" || die 'GL-Thread wurde nicht regulär beendet'
grep -q 'streaming shutdown done' "$log" || die 'regulärer Neutrino-Shutdown nicht vollständig nachweisbar'
printf 'ERFOLG: GUI-Smoke bestanden, kontrollierter Exitcode=%s, Architektur x86-64 geprüft\n' "$exit_code"
