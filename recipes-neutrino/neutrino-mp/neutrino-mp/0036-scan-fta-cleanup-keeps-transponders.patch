From: mpc823 <11076149+mpc823@users.noreply.github.com>
Date: Sat, 31 Oct 2026 15:25:00 +0100
Subject: [PATCH] scan: remove stale non-FTA services in FTA mode

FTA-only applies to services, not to the transponder inventory. Remove stale
scrambled and non-TV/radio services left over from an older scan after a
successful provider scan, while retaining every verified transponder
including transponders that currently carry only encrypted services.

Upstream-Status: Inappropriate [project-specific scan policy]

---
 src/zapit/src/scan.cpp | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/src/zapit/src/scan.cpp b/src/zapit/src/scan.cpp
index f919dfaf8..2f28c7b3e 100644
--- a/src/zapit/src/scan.cpp
+++ b/src/zapit/src/scan.cpp
@@ -547,6 +562,31 @@ void CServiceScan::SaveServices()
 	printf("[scan] save services done\n"); fflush(stdout);
 }
 
+static void RemoveFtaServices(t_satellite_position satellitePosition)
+{
+	CServiceManager *services = CServiceManager::getInstance();
+	tallchans *all_channels = services->GetAllChannels();
+	unsigned int removed_scrambled = 0;
+	unsigned int removed_data = 0;
+	for (tallchans_iterator it = all_channels->begin(); it != all_channels->end();) {
+		tallchans_iterator current = it++;
+		CZapitChannel *channel = &current->second;
+		if (channel->getSatellitePosition() != satellitePosition)
+			continue;
+		const bool data_service = channel->getServiceType(true) != ST_DIGITAL_TELEVISION_SERVICE &&
+			channel->getServiceType(true) != ST_DIGITAL_RADIO_SOUND_SERVICE;
+		if (channel->scrambled || data_service) {
+			services->RemoveChannel(current->first);
+			if (channel->scrambled)
+				++removed_scrambled;
+			if (data_service)
+				++removed_data;
+		}
+	}
+	printf("[scan] FTA cleanup: removed %u scrambled and %u data services, kept all transponders\n",
+		removed_scrambled, removed_data);
+}
+
 bool CServiceScan::ScanProviders()
 {
 	flags = *((int *)scan_arg);
@@ -567,4 +600,6 @@ bool CServiceScan::ScanProviders()
 		CheckSatelliteChannels(position);
 		printf("[scan] scanning %s at %d bouquetMode %d\n", spI->second.c_str(), position, bouquetMode);
 		ScanProvider(position);
+		if (flags & SCAN_FTA)
+			RemoveFtaServices(position);
 		if(abort_scan) {

