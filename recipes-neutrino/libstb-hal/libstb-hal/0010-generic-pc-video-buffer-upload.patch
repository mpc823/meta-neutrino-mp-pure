+VDec::SWFramebuffer *VDec::getDecBufLocked(void)
+{
+	buf_m.lock();
+	if (buf_num == 0) {
+		buf_m.unlock();
+		return NULL;
+	}
+	SWFramebuffer *p = &buffers[buf_out];
+	buf_out++;
+	buf_num--;
+	buf_out %= VDEC_MAXBUFS;
+	return p; /* buf_m remains locked until releaseDecBuf() */
+}
+
+void VDec::releaseDecBuf(void)
+{
+	buf_m.unlock();
+}
