#!/usr/bin/env bash
set -Eeuo pipefail

# Detached, single-run monitor for the Neutrino Yocto build.
# Runtime state and logs live outside the Git worktree.

machine="${2:-raspberrypi2}"
build_target="${NEUTRINO_BUILD_TARGET:-neutrino-image}"
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_root="${NEUTRINO_BUILD_ROOT:-${repo}/../.neutrino-build}"
build_dir="${build_root}/${machine}"
source_dir="${NEUTRINO_SOURCE_DIR:-${build_root}/sources/${machine}}"
state_dir="${build_root}/monitor/${machine}"
state_file="${state_dir}/state"
log_dir="${state_dir}/logs"
wrapper="$(readlink -f "${BASH_SOURCE[0]}")"

mkdir -p "$state_dir" "$log_dir"
umask "${NEUTRINO_UMASK:-022}"

die() { printf 'FEHLER: %s\n' "$*" >&2; exit 1; }
now() { date --iso-8601=seconds; }

read_state() {
    [[ -f "$state_file" ]] || return 1
    # State values are generated by this script and contain no shell syntax.
    while IFS='=' read -r key value; do
        case "$key" in
            state|run_id|started|finished|monitor_pid|build_pid|exit_code|log|recipe|task|reason)
                printf -v "$key" '%s' "$value" ;;
        esac
    done < "$state_file"
}

write_state() {
    local tmp="${state_file}.tmp.$$"
    {
        printf 'state=%s\n' "${state:-}"
        printf 'run_id=%s\n' "${run_id:-}"
        printf 'started=%s\n' "${started:-}"
        printf 'finished=%s\n' "${finished:-}"
        printf 'monitor_pid=%s\n' "${monitor_pid:-}"
        printf 'build_pid=%s\n' "${build_pid:-}"
        printf 'exit_code=%s\n' "${exit_code:-}"
        printf 'log=%s\n' "${log:-}"
        printf 'recipe=%s\n' "${recipe:-neutrino-image}"
        printf 'task=%s\n' "${task:-}"
        printf 'reason=%s\n' "${reason:-}"
    } > "$tmp"
    mv -f "$tmp" "$state_file"
}

pid_matches() {
    local pid="$1" pattern="$2" cmd
    [[ "$pid" =~ ^[0-9]+$ && "$pid" != 0 ]] || return 1
    [[ -r "/proc/$pid/cmdline" ]] || return 1
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline")"
    [[ "$cmd" == *"$pattern"* ]]
}

build_pid_is_live() {
    local ppid
    if [[ "${build_pid:-0}" == 0 ]]; then
        pid_matches "${monitor_pid:-0}" "$wrapper"
        return
    fi
    pid_matches "${build_pid:-0}" "bitbake" && return 0
    pid_matches "${build_pid:-0}" "$wrapper" && return 0
    ppid="$(ps -o ppid= -p "${build_pid:-0}" 2>/dev/null | tr -d ' ' || true)"
    [[ "$ppid" == "${monitor_pid:-}" ]] && kill -0 "${build_pid:-0}" 2>/dev/null
}

notify() {
    local title="$1" body="$2"
    if [[ -n "${NEUTRINO_NOTIFY_LOG:-}" ]]; then
        printf '%s\t%s\t%s\n' "$(now)" "$title" "$body" >> "$NEUTRINO_NOTIFY_LOG"
    fi
    if [[ -n "${NEUTRINO_NOTIFY_COMMAND:-}" ]]; then
        "$NEUTRINO_NOTIFY_COMMAND" "$title" "$body" || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send --urgency=critical "$title" "$body" || true
    fi
}

extract_failure() {
    local text
    text="$(tail -300 "$log" 2>/dev/null || true)"
    recipe="$(printf '%s\n' "$text" | sed -nE 's/.*ERROR: Task \([^/]*\/(.+\.bb):([^)]*)\) failed.*/\1/p' | tail -1)"
    task="$(printf '%s\n' "$text" | sed -nE 's/.*ERROR: Task \([^/]*\/.+\.bb:([^)]*)\) failed.*/\1/p' | tail -1)"
    if [[ -z "$recipe" ]]; then
        recipe="$(printf '%s\n' "$text" | sed -nE 's/.*ERROR: ([^ ]+)-[^ ]+ (do_[^: ]+):.*/\1/p' | tail -1)"
    fi
    task="${task:-unknown-task}"
    recipe="${recipe:-unknown-recipe}"
}

run_build() {
    local rc
    export BB_NUMBER_THREADS="${BB_NUMBER_THREADS:-2}"
    export PARALLEL_MAKE="${PARALLEL_MAKE:--j2}"
    export PATH="${repo}/../../.neutrino-hosttools/root/usr/bin:${repo}/../../.neutrino-tools/bin:${PATH}"
    export LD_LIBRARY_PATH="${repo}/../../.neutrino-hosttools/root/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    # oe-init-build-env intentionally reads a few optional unset variables.
    set +u
    source "${source_dir}/openembedded-core/oe-init-build-env" "$build_dir" >/dev/null
    set -u
    if [[ -n "${NEUTRINO_BITBAKE_BIN:-}" ]]; then
        "$NEUTRINO_BITBAKE_BIN" -k "$build_target"
    else
        exec bitbake -k "$build_target"
    fi
}

monitor_run() {
    trap 'reason="signal"; kill -TERM "$build_pid" 2>/dev/null || true; wait "$build_pid" 2>/dev/null || true; exit_code=143; state="ABGEBROCHEN"; finished="$(now)"; write_state; notify "Neutrino-Build ABGEBROCHEN" "${machine}: $log"; exit 143' INT TERM HUP
    state="STARTET"; started="$(now)"; finished=""; monitor_pid="$$"; build_pid="0"
    run_id="$(date +%Y%m%dT%H%M%S)-$$"; log="${log_dir}/${run_id}.log"; recipe="$build_target"; task=""; reason=""
    write_state
    printf '[%s] STARTET pid=%s\n' "$(now)" "$$" >> "$log"
    run_build >> "$log" 2>&1 &
    build_pid="$!"
    state="LÄUFT"
    write_state
    printf '[%s] LÄUFT bitbake_pid=%s\n' "$(now)" "$build_pid" >> "$log"
    if wait "$build_pid"; then
        exit_code=0
    else
        exit_code=$?
    fi
    finished="$(now)"
    if [[ "$exit_code" == 0 ]]; then
        state="ERFOLGREICH"
        write_state
        notify "Neutrino-Build ERFOLGREICH" "${machine}: neutrino-image fertig"
    elif [[ "$exit_code" == 130 || "$exit_code" == 143 ]]; then
        state="ABGEBROCHEN"
        reason="BitBake beendet mit Exit-Code ${exit_code}"
        write_state
        notify "Neutrino-Build ABGEBROCHEN" "${machine}: ${log}"
    else
        state="FEHLGESCHLAGEN"
        extract_failure
        reason="BitBake beendet mit Exit-Code ${exit_code}"
        write_state
        notify "Neutrino-Build FEHLGESCHLAGEN" "${machine}: ${recipe}:${task} — ${log}"
    fi
    printf '[%s] %s exit=%s\n' "$(now)" "$state" "$exit_code" >> "$log"
    exit "$exit_code"
}

status_cmd() {
    if ! read_state; then
        printf 'KEIN_LAUF\n'
        return 0
    fi
    if [[ "$state" == "STARTET" || "$state" == "LÄUFT" ]]; then
        # The monitor is authoritative while it is alive.  There is a small,
        # legitimate interval after the BitBake child exits and before
        # `wait` writes the terminal state; treating that interval as an
        # orphan would turn a fast failure into a false ABGEBROCHEN result.
        if pid_matches "${monitor_pid:-0}" "$wrapper"; then
            printf '%s run=%s monitor_pid=%s build_pid=%s log=%s\n' "$state" "$run_id" "$monitor_pid" "$build_pid" "$log"
            return 0
        fi
        state="ABGEBROCHEN"; finished="$(now)"; reason="verwaister Monitor oder veraltete PID"; exit_code="143"
        write_state
        printf 'ABGEBROCHEN run=%s reason=%s log=%s\n' "$run_id" "$reason" "$log"
        return 2
    fi
    printf '%s run=%s exit=%s log=%s\n' "$state" "$run_id" "${exit_code:-}" "$log"
}

start_cmd() {
    if [[ -f "$state_file" ]] && read_state && [[ "$state" == "STARTET" || "$state" == "LÄUFT" ]]; then
        if pid_matches "${monitor_pid:-0}" "$wrapper" && build_pid_is_live; then
            die "ein Build läuft bereits (PID ${build_pid})"
        fi
    fi
    mkdir -p "$log_dir"
    nohup setsid "$wrapper" run "$machine" </dev/null >/dev/null 2>&1 &
    local launched="$!"
    # The run process writes the authoritative state immediately. Wait briefly
    # so callers see STARTET/LÄUFT rather than an uninitialized file.
    for _ in {1..50}; do
        [[ -f "$state_file" ]] && break
        sleep 0.1
    done
    if ! [[ -f "$state_file" ]]; then
        die "Monitor konnte nicht gestartet werden (launcher PID ${launched})"
    fi
    status_cmd || true
}

stop_cmd() {
    read_state || die "kein Buildstatus vorhanden"
    [[ "$state" == "STARTET" || "$state" == "LÄUFT" ]] || { printf '%s\n' "$state"; return 0; }
    kill -TERM "$monitor_pid" 2>/dev/null || true
    printf 'ABBRUCH ANGEFORDERT monitor_pid=%s build_pid=%s\n' "$monitor_pid" "$build_pid"
}

case "${1:-status}" in
    start) start_cmd ;;
    status) status_cmd ;;
    stop) stop_cmd ;;
    run) monitor_run ;;
    *) die "Verwendung: $0 {start|status|stop} [machine]" ;;
esac
