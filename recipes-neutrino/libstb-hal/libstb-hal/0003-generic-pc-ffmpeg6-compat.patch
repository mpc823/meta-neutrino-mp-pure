--- /dev/null
+++ b/generic-pc/ffmpeg_compat.h
@@ -0,0 +1,36 @@
+#ifndef GENERIC_PC_FFMPEG_COMPAT_H
+#define GENERIC_PC_FFMPEG_COMPAT_H
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+}
+
+static inline int hal_decode_video(AVCodecContext *c, AVFrame *frame,
+ int *got, AVPacket *packet)
+{
+#if LIBAVCODEC_VERSION_MAJOR >= 58
+ int ret = avcodec_send_packet(c, packet);
+ if (ret < 0) { *got = 0; return ret; }
+ ret = avcodec_receive_frame(c, frame);
+ *got = (ret == 0);
+ return ret == 0 ? packet->size : ret;
+#else
+ return avcodec_decode_video2(c, frame, got, packet);
+#endif
+}
+
+static inline int hal_decode_audio(AVCodecContext *c, AVFrame *frame,
+ int *got, AVPacket *packet)
+{
+#if LIBAVCODEC_VERSION_MAJOR >= 58
+ int ret = avcodec_send_packet(c, packet);
+ if (ret < 0) { *got = 0; return ret; }
+ ret = avcodec_receive_frame(c, frame);
+ *got = (ret == 0);
+ return ret == 0 ? packet->size : ret;
+#else
+ return avcodec_decode_audio4(c, frame, got, packet);
+#endif
+}
+
+#endif
