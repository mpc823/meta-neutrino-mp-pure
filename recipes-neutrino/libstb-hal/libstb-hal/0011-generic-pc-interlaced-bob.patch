+/* Generic-PC presents decoded frames as progressive OpenGL textures. DVB
+ * MPEG-2/H.264 services are often interlaced; weaving both fields directly
+ * produces horizontal combing on moving objects. Bob each field instead. */
+static void deinterlace_bob(uint8_t *pixels, int stride, int height, bool top_field_first)
+{
+	if (!pixels || stride <= 0 || height < 2)
+		return;
+	const int keep_field = top_field_first ? 0 : 1;
+	for (int y = 0; y < height; ++y) {
+		if ((y & 1) == keep_field)
+			continue;
+		int source = top_field_first ? y - 1 : y + 1;
+		if (source < 0 || source >= height || ((source & 1) != keep_field))
+			source = top_field_first ? y + 1 : y - 1;
+		if (source >= 0 && source < height)
+			memcpy(pixels + y * stride, pixels + source * stride, stride);
+	}
+}
