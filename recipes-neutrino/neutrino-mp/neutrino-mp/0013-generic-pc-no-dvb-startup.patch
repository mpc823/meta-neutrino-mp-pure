diff --git a/src/neutrino.cpp b/src/neutrino.cpp
--- a/src/neutrino.cpp
+++ b/src/neutrino.cpp
@@ -2028,0 +2029,16 @@
+#ifdef HAVE_GENERIC_HARDWARE
+static bool generic_pc_no_frontend()
+{
+	const char *override = getenv("NEUTRINO_PC_NO_DVB");
+	if (override)
+		return strcmp(override, "0") != 0;
+	struct stat st;
+	char path[64];
+	for (int adapter = 0; adapter < 16; ++adapter) {
+		snprintf(path, sizeof(path), "/dev/dvb/adapter%d/frontend0", adapter);
+		if (stat(path, &st) == 0)
+			return false;
+	}
+	return true;
+}
+#endif
@@ -2039,0 +2040,13 @@ void CNeutrinoApp::InitZapper()
+#ifdef HAVE_GENERIC_HARDWARE
+	if (generic_pc_no_frontend()) {
+		/* Keep the common core and GUI usable without a local tuner. */
+		g_InfoViewer->start();
+		lastChannelMode = g_settings.channel_mode;
+		mode = NeutrinoModes::mode_tv;
+		lastMode = mode;
+		SDTreloadChannels = false;
+		channelsInit();
+		return;
+	}
+#endif
+
@@ -2379,2 +2393,9 @@ TIMER_START();
-	/* later on, we'll crash anyway, so tell about it. */
-	if (! zapit_init)
+#if defined(HAVE_GENERIC_HARDWARE)
+	/* Missing local hardware is a runtime capability state, not a fatal GUI error. */
+	if (! zapit_init && !generic_pc_no_frontend())
+		DisplayErrorMessage("Zapit initialization failed. This is a fatal error, sorry.");
+#else
+	/* Receiver targets retain the historical fatal diagnostic. */
+	if (! zapit_init)
+		DisplayErrorMessage("Zapit initialization failed. This is a fatal error, sorry.");
+#endif
