#!/usr/bin/env bash
set -Eeuo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
machine="raspberrypi2"
mode="quick"
build_root="${NEUTRINO_BUILD_ROOT:-${repo}/../.neutrino-build}"
target="${NEUTRINO_BUILD_TARGET:-neutrino-image}"
failures=0
warnings=0

usage() {
	cat <<'EOF'
Usage: scripts/preflight [--quick|--full|--fetch] [--machine MACHINE]

  --quick    host, repository, recipes, patches and resource checks
  --full     quick checks plus Yocto/KAS metadata parsing and BitBake parse
  --fetch    full checks plus bitbake -c fetch (may populate DL_DIR)
EOF
}
die_check() { printf 'FAIL: %s\n' "$*" >&2; failures=$((failures + 1)); }
warn_check() { printf 'WARN: %s\n' "$*" >&2; warnings=$((warnings + 1)); }
pass_check() { printf 'PASS: %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

while (($#)); do
	case "$1" in
		--quick) mode=quick ;;
		--full) mode=full ;;
		--fetch) mode=fetch ;;
		--machine) shift; [[ $# -gt 0 ]] || { usage >&2; exit 2; }; machine="$1" ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; exit 2 ;;
	esac
	shift
done

printf 'Neutrino preflight: mode=%s machine=%s target=%s\n' "$mode" "$machine" "$target"
printf 'Repository: %s\n' "$repo"

if [[ "$machine" == hd51 ]]; then
	if [[ -f "$repo/conf/machine/hd51.conf" ]]; then
		pass_check 'HD51 machine contract present'
	else
		die_check 'HD51 machine contract missing'
	fi
	warn_check 'HD51 requires the matching external OpenPLi meta-gfutures BSP; no bootable image is claimed by this preflight'
fi

for command in bash git rg patch make cc c++ ar ld readelf file pkg-config python3 df free awk sed; do
	have "$command" && pass_check "tool $command: $(command -v "$command")" || die_check "required tool missing: $command"
done
for command in kas bitbake gdb gdbserver gdb-multiarch; do
	have "$command" && pass_check "optional/Yocto tool $command: $(command -v "$command")" || warn_check "tool missing: $command"
done

if [[ -d "$repo/.git" ]]; then
	pass_check "Git repository present"
	branch="$(git -C "$repo" branch --show-current)"
	printf 'Git branch: %s\n' "${branch:-detached}"
	[[ -n "$(git -C "$repo" status --porcelain)" ]] && warn_check "working tree contains local changes" || pass_check "working tree clean"
else
	die_check "not a Git worktree: $repo"
fi

if have dpkg-query; then
	packages=(build-essential git curl file patch pkg-config python3 python3-venv
		libavformat-dev libavcodec-dev libavutil-dev libswresample-dev libswscale-dev
		libao-dev libopenthreads-dev libsigc++-2.0-dev libpugixml-dev libfreetype-dev
		libpng-dev libjpeg-dev libgif-dev freeglut3-dev libglew-dev)
	for package in "${packages[@]}"; do
		status="$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)"
		[[ "$status" == 'install ok installed' ]] || warn_check "Debian package missing: $package"
	done
else
	warn_check "dpkg-query unavailable; package database was not checked"
fi

pkg_modules=(libavformat libavcodec libavutil libswresample libswscale ao OpenThreads sigc++-2.0 pugixml freetype2 libpng libjpeg giflib glut glew)
for module in "${pkg_modules[@]}"; do
	if pkg-config --exists "$module" 2>/dev/null; then
		pass_check "pkg-config module: $module"
	elif [[ "$module" == OpenThreads ]] && [[ -f /usr/include/OpenThreads/Thread ]] && grep -q 'libOpenThreads\.so' < <(ldconfig -p 2>/dev/null); then
		pass_check 'OpenThreads headers/library available (no pkg-config file)'
	elif [[ "$module" == giflib ]] && [[ -f /usr/include/gif_lib.h ]] && grep -q 'libgif\.so' < <(ldconfig -p 2>/dev/null); then
		pass_check 'giflib headers/library available (no pkg-config file)'
	else
		warn_check "pkg-config module missing: $module"
	fi
done

python3 - <<'PY' >/dev/null 2>&1 && pass_check 'Python yaml module available' || warn_check 'Python yaml module missing (needed by kas)'
import yaml
PY

if [[ -f "$repo/kas/wrynose.yml" ]]; then
	if rg -q '^  [A-Za-z0-9_-]+:.*$' "$repo/kas/wrynose.yml" &&
	   [[ "$(rg -c 'commit: [0-9a-f]{40}' "$repo/kas/wrynose.yml")" -ge 5 ]]; then
		pass_check 'KAS configuration contains pinned layer commits'
	else
		die_check 'KAS configuration is missing pinned layer commits'
	fi
else
	die_check 'kas/wrynose.yml missing'
fi

if "$repo/scripts/validate-layer" >/tmp/neutrino-preflight-layer.$$ 2>&1; then
	pass_check 'Yocto layer static validation'
else
	sed 's/^/  /' /tmp/neutrino-preflight-layer.$$ >&2
	die_check 'Yocto layer static validation failed'
fi
rm -f /tmp/neutrino-preflight-layer.$$

recipe="$repo/recipes-neutrino/neutrino-mp/neutrino-mp_git.bb"
if [[ -f "$recipe" ]]; then
	missing_patch=0
	while read -r uri; do
		name="${uri#file://}"
		[[ "$name" == *'${'* ]] && continue
		if [[ ! -f "$repo/recipes-neutrino/neutrino-mp/neutrino-mp/$name" &&
	      ! -f "$repo/recipes-neutrino/neutrino-mp/$name" ]]; then
			printf '  missing SRC_URI file: %s\n' "$name" >&2
			missing_patch=1
		fi
	done < <(rg -o 'file://[^[:space:]"\\]+' "$recipe" | sort -u)
	((missing_patch == 0)) && pass_check 'neutrino-mp local SRC_URI files present' || die_check 'neutrino-mp local SRC_URI file missing'
else
	die_check 'neutrino-mp recipe missing'
fi

check_resources() {
	local path="$1" avail_kb avail_inodes mem_kb swap_kb
	avail_kb="$(df -Pk "$path" | awk 'NR==2 {print $4}')"
	avail_inodes="$(df -Pi "$path" | awk 'NR==2 {print $4}')"
	mem_kb="$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)"
	swap_kb="$(awk '/SwapFree:/ {print $2}' /proc/meminfo)"
	printf 'Resources: disk=%sKiB inodes=%s RAM=%sKiB swap=%sKiB\n' "$avail_kb" "$avail_inodes" "$mem_kb" "$swap_kb"
	((avail_kb >= 30 * 1024 * 1024)) && pass_check 'at least 30 GiB free disk' || warn_check 'less than 30 GiB free disk'
	((avail_inodes >= 1000000)) && pass_check 'at least one million free inodes' || warn_check 'less than one million free inodes'
	((mem_kb + swap_kb >= 4 * 1024 * 1024)) && pass_check 'RAM+swap >= 4 GiB' || warn_check 'RAM+swap below 4 GiB'
}
check_resources "$repo"

if [[ "$mode" == quick ]]; then
	printf 'Yocto metadata/fetch checks: SKIPPED (use --full or --fetch)\n'
else
	source_dir="${NEUTRINO_SOURCE_DIR:-${build_root}/sources/${machine}}"
	build_dir="${build_root}/${machine}"
	if [[ ! -x "$source_dir/openembedded-core/oe-init-build-env" ]]; then
		die_check "cannot find Yocto source tree: $source_dir"
	elif ! have bitbake && [[ ! -x "$source_dir/bitbake/bin/bitbake" ]]; then
		die_check "BitBake unavailable in PATH and source tree: $source_dir"
	else
		bitbake_cmd="$(command -v bitbake 2>/dev/null || printf '%s' "$source_dir/bitbake/bin/bitbake")"
		printf 'Yocto metadata source: %s\n' "$source_dir"
		if set +u; source "$source_dir/openembedded-core/oe-init-build-env" "$build_dir" >/dev/null; set -u; then
			if "$bitbake_cmd" -p "$target"; then
				pass_check 'BitBake metadata parse'
			else
				die_check 'BitBake metadata parse failed'
			fi
			if [[ "$mode" == fetch ]]; then
				if "$bitbake_cmd" -c fetch "$target"; then
					pass_check 'BitBake fetch and checksum verification'
				else
					die_check 'BitBake fetch failed'
				fi
			fi
		else
			die_check "cannot initialize Yocto environment: $source_dir"
		fi
	fi
fi

if ((failures)); then
	printf 'PREFLIGHT=FAIL failures=%d warnings=%d\n' "$failures" "$warnings" >&2
	exit 1
fi
printf 'PREFLIGHT=PASS failures=0 warnings=%d\n' "$warnings"
