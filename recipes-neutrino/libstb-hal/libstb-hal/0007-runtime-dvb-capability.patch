diff --git a/common/runtime_caps.h b/common/runtime_caps.h
new file mode 100644
--- /dev/null
+++ b/common/runtime_caps.h
@@ -0,0 +1,15 @@
+/* Runtime resource probes shared by all libstb-hal backends. */
+#ifndef LIBSTB_HAL_RUNTIME_CAPS_H
+#define LIBSTB_HAL_RUNTIME_CAPS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int hardware_has_local_dvb(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/common/runtime_caps.c b/common/runtime_caps.c
new file mode 100644
--- /dev/null
+++ b/common/runtime_caps.c
@@ -0,0 +1,17 @@
+#include "runtime_caps.h"
+#include <stdio.h>
+#include <sys/stat.h>
+
+int hardware_has_local_dvb(void)
+{
+	char path[64];
+	struct stat st;
+	int adapter;
+
+	for (adapter = 0; adapter < 16; ++adapter) {
+		snprintf(path, sizeof(path), "/dev/dvb/adapter%d/frontend0", adapter);
+		if (stat(path, &st) == 0 && S_ISCHR(st.st_mode))
+			return 1;
+	}
+	return 0;
+}
